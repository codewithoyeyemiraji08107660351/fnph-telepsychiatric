NOTIFICATION_EMAIL_ENABLED=true

# --- Remita (live) -------------------------------------------------------
# Going live needs two values from Remita's live credentials email:
#   REMITA_API_BASE_URL  the live Connect Gateway host, no path
#   REMITA_SECRET_KEY    the live secret key (sk_live_...)
# The app starts without them and logs what is missing; payments start only
# once both are set. Never put test keys here.
REMITA_API_BASE_URL=
REMITA_SECRET_KEY=
REMITA_READ_TIMEOUT_SECONDS=30
REMITA_CONNECT_TIMEOUT_SECONDS=10
# openssl rand -hex 24. Give Remita this callback URL:
#   https://<APP_BASE_URL host>/api/v1/webhooks/remita/<REMITA_WEBHOOK_SECRET>
REMITA_WEBHOOK_SECRET=
# Leave unset in production. True is for the demo host only, and the app
# refuses to start with it on against a live host.
# REMITA_ACCEPT_CHARGE_SUCCESS_AS_PAID=false


# --- Video (Daily.co) ------------------------------------------------------
VIDEO_PROVIDER=daily
DAILY_BASE_URL=https://api.daily.co/v1
DAILY_API_KEY=daacde1aa258d4f5439ef485246888923f8c69942eca66a88b3b2b7d0fc2447c
DAILY_DOMAIN=https://go-api.daily.co
DAILY_WEBHOOK_SECRET=https://api.daily.co/v1/webhooks

# --- Behaviour ------------------------------------------------------------
ENROLMENT_REQUIRE_CORROBORATION=false
UPLOAD_REQUIRE_CLEAN_SCAN=false
