# Production environment for the Dokploy Compose service.
# Paste into Dokploy > the service > Environment. Never commit real values.
#
# Generate each secret on the VPS or any machine with openssl:
#   openssl rand -base64 64    -> JWT_SECRET
#   openssl rand -base64 32    -> ENCRYPTION_KEY   (set once, never change)
#   openssl rand -hex 24       -> passwords and REMITA_WEBHOOK_SECRET

# --- Public addresses ---------------------------------------------------
# The API's own HTTPS address (the domain you attach in Dokploy).
APP_BASE_URL=https://fnphkad.cloud
# Where the web app is served. Email links point here.
APP_PORTAL_URL=https://fnphkad.cloud
# The web app's address, exactly, comma-separated if more than one.
CORS_ALLOWED_ORIGINS=https://fnphkad.cloud

# --- Database (MySQL runs inside the stack) -----------------------------
DB_NAME=telepsychiatric
DB_USERNAME=fnph_app
DB_PASSWORD=722935a6ef9f3c8dfab1fae1d231180a206d60672bb65cf5
DB_ROOT_PASSWORD=57c6867cef57575cbfbdce90d06215bc23a44385908fb283

# --- Redis and RabbitMQ (inside the stack) -------------------------------
REDIS_PASSWORD=88542f397d63adad3b0335a08eab8a185f33cd1707e37552
RABBITMQ_USERNAME=fnph
RABBITMQ_PASSWORD=5d20ba2297c4505cbc13fe378e07b610da4cdd8c550d5ddf

