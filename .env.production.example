# Production environment for the Dokploy Compose service.
# Paste into Dokploy > the service > Environment. Never commit real values.
#
# Generate each secret on the VPS or any machine with openssl:
#   openssl rand -base64 64    -> JWT_SECRET
#   openssl rand -base64 32    -> ENCRYPTION_KEY   (set once, never change)
#   openssl rand -hex 24       -> passwords and REMITA_WEBHOOK_SECRET

# --- Public addresses ---------------------------------------------------
# The API's own HTTPS address (the domain you attach in Dokploy).
APP_BASE_URL=https://api.example.org
# Where the web app is served. Email links point here.
APP_PORTAL_URL=https://portal.example.org
# The web app's address, exactly, comma-separated if more than one.
CORS_ALLOWED_ORIGINS=https://portal.example.org

# --- Database (MySQL runs inside the stack) -----------------------------
DB_NAME=telepsychiatric
DB_USERNAME=fnph_app
DB_PASSWORD=change-me-hex-24
DB_ROOT_PASSWORD=change-me-hex-24

# --- Redis and RabbitMQ (inside the stack) -------------------------------
REDIS_PASSWORD=change-me-hex-24
RABBITMQ_USERNAME=fnph
RABBITMQ_PASSWORD=change-me-hex-24

# --- Security -------------------------------------------------------------
JWT_SECRET=change-me-base64-64
# Changing this later makes every enrolled authenticator unreadable.
ENCRYPTION_KEY=change-me-base64-32
MFA_REQUIRED=true

# --- Email ------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
# Gmail app password, 16 characters, no spaces.
MAIL_PASSWORD=change-me
MAIL_FROM=you@gmail.com
NOTIFICATION_EMAIL_ENABLED=true

# --- Remita (required to start; real values required to take payments) ----
REMITA_BASE_URL=https://demo.remita.net
REMITA_MERCHANT_ID=change-me
REMITA_SERVICE_TYPE_ID=change-me
REMITA_API_KEY=change-me
REMITA_API_TOKEN=change-me
REMITA_WEBHOOK_SECRET=change-me-hex-24

# --- Video (Daily.co) ------------------------------------------------------
VIDEO_PROVIDER=daily
DAILY_API_KEY=
DAILY_DOMAIN=
DAILY_WEBHOOK_SECRET=

# --- Behaviour ------------------------------------------------------------
ENROLMENT_REQUIRE_CORROBORATION=false
UPLOAD_REQUIRE_CLEAN_SCAN=false
